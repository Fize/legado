<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="io.legado.app.test.SidecarControlProvider"
            android:authorities="com.xiaobaitu.reader.debug.test.sidecar.control"
            android:exported="true" />
        <provider
            android:name="io.legado.app.test.SidecarDocumentsProvider"
            android:authorities="com.xiaobaitu.reader.debug.test.sidecar"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
